<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BibliotecarioActivity">

    <!-- Campo para el código del bibliotecario -->
    <EditText
        android:id="@+id/editCodigo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Código del Bibliotecario"
        android:inputType="text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:padding="16dp" />

    <!-- Campo para el nombre del bibliotecario -->
    <EditText
        android:id="@+id/editNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nombre del Bibliotecario"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/editCodigo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:padding="16dp" />

    <!-- Botón para agregar bibliotecario -->
    <Button
        android:id="@+id/btnAgregarBibliotecario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#D0A5A5"
        android:padding="16dp"
        android:text="Agregar Bibliotecario"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editNombre" />

    <!-- Botón para eliminar bibliotecario -->
    <Button
        android:id="@+id/btnEliminarBibliotecario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#D0A5A5"
        android:padding="16dp"
        android:text="Eliminar Bibliotecario"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAgregarBibliotecario" />

    <!-- Botón para modificar bibliotecario -->
    <Button
        android:id="@+id/btnModificarBibliotecario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#D0A5A5"
        android:padding="16dp"
        android:text="Modificar Bibliotecario"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnEliminarBibliotecario" />

    <!-- ListView para mostrar bibliotecarios -->
    <ListView
        android:id="@+id/listViewBibliotecarios"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnModificarBibliotecario"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnVolver"
        android:padding="16dp" />

    <!-- Botón para volver -->
    <Button
        android:id="@+id/btnVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#DB6D6D"
        android:padding="16dp"
        android:text="Volver"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
